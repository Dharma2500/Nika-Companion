{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nika.local/schemas/minecraft-observation-v3.schema.json",
  "title": "Nika Minecraft client observation v3",
  "description": "A manually requested, read-only snapshot with bounded loaded-only block sampling, local environment and player movement state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client",
    "world",
    "player"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraft_version",
        "mod_version"
      ],
      "properties": {
        "minecraft_version": {
          "const": "1.21.11"
        },
        "mod_version": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "block_sample",
        "environment"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/resourceLocation"
        },
        "block_sample": {
          "$ref": "#/$defs/blockSample"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "biome",
            "time_of_day_ticks",
            "raining",
            "thundering",
            "light_level"
          ],
          "properties": {
            "biome": {
              "$ref": "#/$defs/resourceLocation"
            },
            "time_of_day_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23999
            },
            "raining": {
              "type": "boolean"
            },
            "thundering": {
              "type": "boolean"
            },
            "light_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          }
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "health",
        "food_level",
        "selected_item",
        "state"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "type": "number",
          "minimum": -2048,
          "maximum": 2048
        },
        "z": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "health": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024
        },
        "food_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "selected_item": {
          "$ref": "#/$defs/resourceLocation"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "game_mode",
            "on_ground",
            "sprinting",
            "swimming",
            "crouching"
          ],
          "properties": {
            "game_mode": {
              "type": "string",
              "enum": [
                "survival",
                "creative",
                "adventure",
                "spectator"
              ]
            },
            "on_ground": {
              "type": "boolean"
            },
            "sprinting": {
              "type": "boolean"
            },
            "swimming": {
              "type": "boolean"
            },
            "crouching": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resourceLocation": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "blockSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center",
        "range",
        "scanned_positions",
        "non_air_blocks",
        "truncated",
        "blocks"
      ],
      "properties": {
        "center": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": -30000000,
              "maximum": 30000000
            },
            "y": {
              "type": "integer",
              "minimum": -2048,
              "maximum": 2048
            },
            "z": {
              "type": "integer",
              "minimum": -30000000,
              "maximum": 30000000
            }
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "const": 2
            },
            "y": {
              "const": 1
            },
            "z": {
              "const": 2
            }
          }
        },
        "scanned_positions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 75
        },
        "non_air_blocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 75
        },
        "truncated": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dx",
        "dy",
        "dz",
        "id",
        "properties",
        "properties_truncated"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "dy": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "dz": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "id": {
          "$ref": "#/$defs/resourceLocation"
        },
        "properties": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_.-]{1,64}$"
          }
        },
        "properties_truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
