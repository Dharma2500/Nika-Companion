{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nika.local/schemas/minecraft-observation-v1.schema.json",
  "title": "Nika Minecraft client observation v1",
  "description": "A manually requested, read-only snapshot of a small set of client-visible fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client", "world", "player"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraft_version", "mod_version"],
      "properties": {
        "minecraft_version": {
          "const": "1.21.11"
        },
        "mod_version": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension"],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/resourceLocation"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "health", "food_level", "selected_item"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "type": "number",
          "minimum": -2048,
          "maximum": 2048
        },
        "z": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "health": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024
        },
        "food_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "selected_item": {
          "$ref": "#/$defs/resourceLocation"
        }
      }
    }
  },
  "$defs": {
    "resourceLocation": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    }
  }
}
